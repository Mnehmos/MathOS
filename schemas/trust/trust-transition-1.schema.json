{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnehmos.ai/mathos/schemas/trust/transition/1",
  "title": "MathOS Reviewed Trust Transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "formalization", "dimension", "from_status", "to_status", "reviewer_identity", "evidence_artifact_hashes", "reason", "predecessor_transition_id"],
  "properties": {
    "schema_version": {"const": "trust_transition/1"},
    "formalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "version_hash"],
      "properties": {
        "object_id": {"type": "string", "format": "uuid"},
        "version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dimension": {"enum": ["definition", "reuse", "coverage"]},
    "from_status": {"$ref": "#/$defs/reviewed_status"},
    "to_status": {"$ref": "#/$defs/reviewed_status"},
    "reviewer_identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "evidence_artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash"}
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "predecessor_transition_id": {"type": ["string", "null"], "format": "uuid"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_status": {
      "enum": [
        "ungrounded", "source_grounded", "project_approved", "upstream_accepted",
        "experimental", "campaign_specific", "candidate", "review_ready", "upstreamed",
        "unknown", "statement_only", "analytical_core", "supporting_lemma",
        "finite_specialization", "asymptotic_component", "full_theorem"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"dimension": {"const": "definition"}}},
      "then": {
        "properties": {
          "from_status": {"enum": ["ungrounded", "source_grounded", "project_approved", "upstream_accepted"]},
          "to_status": {"enum": ["ungrounded", "source_grounded", "project_approved", "upstream_accepted"]}
        }
      }
    },
    {
      "if": {"properties": {"dimension": {"const": "reuse"}}},
      "then": {
        "properties": {
          "from_status": {"enum": ["experimental", "campaign_specific", "candidate", "review_ready", "upstreamed"]},
          "to_status": {"enum": ["experimental", "campaign_specific", "candidate", "review_ready", "upstreamed"]}
        }
      }
    },
    {
      "if": {"properties": {"dimension": {"const": "coverage"}}},
      "then": {
        "properties": {
          "from_status": {"enum": ["unknown", "statement_only", "analytical_core", "supporting_lemma", "finite_specialization", "asymptotic_component", "full_theorem"]},
          "to_status": {"enum": ["unknown", "statement_only", "analytical_core", "supporting_lemma", "finite_specialization", "asymptotic_component", "full_theorem"]}
        }
      }
    }
  ]
}
