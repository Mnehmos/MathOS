{
  "$id": "https://mnehmos.ai/mathos/schemas/publication/request/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "axiom_audit_evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "axiom_audit_evidence_id": {
      "format": "uuid",
      "type": "string"
    },
    "declaration_name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "diagnostic_evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "diagnostic_evidence_id": {
      "format": "uuid",
      "type": "string"
    },
    "environment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "module_artifact_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "proof",
        "refutation"
      ]
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "archive_artifact_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "archive_root": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "module_path": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "archive_artifact_hash",
        "archive_root",
        "module_path"
      ],
      "type": "object"
    },
    "proof_closure_evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "proof_closure_evidence_id": {
      "format": "uuid",
      "type": "string"
    },
    "schema_version": {
      "const": "publication_request/1"
    },
    "source_commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_tree_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "format": "uuid",
          "type": "string"
        },
        "version_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "version_hash"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "subject",
    "outcome",
    "diagnostic_evidence_id",
    "diagnostic_evidence_hash",
    "proof_closure_evidence_id",
    "proof_closure_evidence_hash",
    "axiom_audit_evidence_id",
    "axiom_audit_evidence_hash",
    "environment_hash",
    "module_artifact_hash",
    "declaration_name",
    "policy_hash",
    "source_commit_sha",
    "source_tree_sha"
  ],
  "title": "MathOS Publication Request v1",
  "type": "object"
}
