{
  "$id": "https://mnehmos.ai/mathos/schemas/publication/stage/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attestation_bundle_artifact_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "attestation_bundle_byte_size": {
      "maximum": 16777216,
      "minimum": 1,
      "type": "integer"
    },
    "authoritative": {
      "const": false
    },
    "report_artifact_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "report_byte_size": {
      "maximum": 16777216,
      "minimum": 1,
      "type": "integer"
    },
    "retained_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "byte_size": {
            "maximum": 16777216,
            "minimum": 0,
            "type": "integer"
          },
          "identity_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "path": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "enum": [
              "audit_job",
              "audit_policy",
              "audit_report",
              "audit_stderr",
              "audit_stdout",
              "axiom_audit_evidence",
              "claim_version",
              "diagnostic_evidence",
              "environment_manifest",
              "formalization_version",
              "lean_module",
              "lean_project_archive",
              "proof_closure_evidence",
              "protected_audit_stderr",
              "protected_audit_stdout",
              "protected_dependency_stderr",
              "protected_dependency_stdout",
              "protected_stderr",
              "protected_stdout",
              "publication_policy",
              "publication_request",
              "source_version",
              "verifier_job",
              "verifier_report",
              "verifier_stderr",
              "verifier_stdout"
            ]
          }
        },
        "required": [
          "role",
          "path",
          "identity_hash",
          "artifact_hash",
          "byte_size"
        ],
        "type": "object"
      },
      "maxItems": 25,
      "minItems": 20,
      "type": "array"
    },
    "retained_closure_artifact_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "retained_closure_byte_size": {
      "maximum": 16777216,
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "publication_stage/1"
    }
  },
  "required": [
    "schema_version",
    "report_artifact_hash",
    "report_byte_size",
    "retained_closure_artifact_hash",
    "retained_closure_byte_size",
    "attestation_bundle_artifact_hash",
    "attestation_bundle_byte_size",
    "retained_artifacts",
    "authoritative"
  ],
  "title": "MathOS Publication Stage v1",
  "type": "object"
}
