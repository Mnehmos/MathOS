{
  "$defs": {
    "exact_ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "format": "uuid",
          "type": "string"
        },
        "version_hash": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "object_id",
        "version_hash"
      ],
      "type": "object"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "member": {
      "additionalProperties": false,
      "properties": {
        "artifact_metadata": {
          "oneOf": [
            {
              "$ref": "https://mnehmos.ai/mathos/schemas/artifact/metadata/1"
            },
            {
              "type": "null"
            }
          ]
        },
        "byte_size": {
          "maximum": 268435456,
          "minimum": 0,
          "type": "integer"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "kind": {
          "enum": [
            "object",
            "edge",
            "evidence",
            "artifact",
            "environment",
            "license",
            "replay",
            "report",
            "export"
          ]
        },
        "license_expression": {
          "maxLength": 512,
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "restriction": {
          "enum": [
            "public",
            "restricted",
            "private"
          ]
        }
      },
      "required": [
        "path",
        "kind",
        "content_hash",
        "byte_size",
        "license_expression",
        "restriction",
        "artifact_metadata"
      ],
      "type": "object"
    },
    "pedagogy": {
      "additionalProperties": false,
      "properties": {
        "edge_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "include_soft": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "prerequisites",
            "recommended"
          ]
        },
        "root": {
          "$ref": "#/$defs/exact_ref"
        },
        "unit_order": {
          "items": {
            "$ref": "#/$defs/exact_ref"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "mode",
        "include_soft",
        "root",
        "unit_order",
        "edge_ids"
      ],
      "type": "object"
    },
    "publication": {
      "additionalProperties": false,
      "properties": {
        "attestation_bundle_artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "authority_evidence_hash": {
          "$ref": "#/$defs/hash"
        },
        "authority_evidence_id": {
          "format": "uuid",
          "type": "string"
        },
        "declaration_name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "environment_hash": {
          "$ref": "#/$defs/hash"
        },
        "fidelity_evidence_hash": {
          "$ref": "#/$defs/hash"
        },
        "fidelity_evidence_id": {
          "format": "uuid",
          "type": "string"
        },
        "fidelity_report_artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "ingestion_receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "module_artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "outcome": {
          "enum": [
            "proof",
            "refutation"
          ]
        },
        "policy_hash": {
          "$ref": "#/$defs/hash"
        },
        "project": {
          "additionalProperties": false,
          "properties": {
            "archive_artifact_hash": {
              "$ref": "#/$defs/hash"
            },
            "archive_root": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "module_path": {
              "maxLength": 512,
              "minLength": 6,
              "pattern": "^[A-Za-z0-9_']+(/[A-Za-z0-9_']+)*\\.lean$",
              "type": "string"
            }
          },
          "required": [
            "archive_artifact_hash",
            "archive_root",
            "module_path"
          ],
          "type": "object"
        },
        "raw_verification_hash": {
          "$ref": "#/$defs/hash"
        },
        "report_artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "request_hash": {
          "$ref": "#/$defs/hash"
        },
        "retained_closure_artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "stage_hash": {
          "$ref": "#/$defs/hash"
        },
        "subject": {
          "$ref": "#/$defs/exact_ref"
        }
      },
      "required": [
        "ingestion_receipt_hash",
        "authority_evidence_id",
        "authority_evidence_hash",
        "fidelity_evidence_id",
        "fidelity_evidence_hash",
        "fidelity_report_artifact_hash",
        "stage_hash",
        "report_artifact_hash",
        "retained_closure_artifact_hash",
        "attestation_bundle_artifact_hash",
        "raw_verification_hash",
        "request_hash",
        "policy_hash",
        "subject",
        "outcome",
        "environment_hash",
        "module_artifact_hash",
        "declaration_name"
      ],
      "type": "object"
    },
    "replay": {
      "additionalProperties": false,
      "properties": {
        "declaration_name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "environment_path": {
          "const": "replay/environment.json"
        },
        "module_path": {
          "const": "replay/Submission.lean"
        },
        "project_archive_path": {
          "const": "replay/project.tar"
        }
      },
      "required": [
        "module_path",
        "environment_path",
        "declaration_name"
      ],
      "type": "object"
    },
    "trust": {
      "additionalProperties": false,
      "properties": {
        "assessment_hash": {
          "$ref": "#/$defs/hash"
        },
        "coverage_status": {
          "enum": [
            "unknown",
            "statement_only",
            "analytical_core",
            "supporting_lemma",
            "finite_specialization",
            "asymptotic_component",
            "full_theorem"
          ]
        },
        "definition_status": {
          "enum": [
            "ungrounded",
            "source_grounded",
            "project_approved",
            "upstream_accepted"
          ]
        },
        "eligible": {
          "const": true
        },
        "fidelity_status": {
          "enum": [
            "unreviewed",
            "source_mapped",
            "reviewer_checked",
            "expert_approved",
            "rejected"
          ]
        },
        "kernel_status": {
          "enum": [
            "unverified",
            "lean_checked",
            "kernel_verified",
            "failed"
          ]
        },
        "profile": {
          "enum": [
            "experimental",
            "publication",
            "upstream"
          ]
        },
        "reuse_status": {
          "enum": [
            "experimental",
            "campaign_specific",
            "candidate",
            "review_ready",
            "upstreamed"
          ]
        },
        "subject": {
          "$ref": "#/$defs/exact_ref"
        }
      },
      "required": [
        "assessment_hash",
        "profile",
        "subject",
        "kernel_status",
        "fidelity_status",
        "definition_status",
        "reuse_status",
        "coverage_status",
        "eligible"
      ],
      "type": "object"
    }
  },
  "$id": "https://mnehmos.ai/mathos/schemas/release/manifest/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "members": {
      "items": {
        "$ref": "#/$defs/member"
      },
      "maxItems": 4096,
      "minItems": 1,
      "type": "array"
    },
    "pedagogy": {
      "$ref": "#/$defs/pedagogy"
    },
    "profile": {
      "enum": [
        "private",
        "public"
      ]
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "replay": {
      "$ref": "#/$defs/replay"
    },
    "schema_version": {
      "const": "release_manifest/2"
    },
    "trust": {
      "$ref": "#/$defs/trust"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "publication",
    "pedagogy",
    "replay",
    "trust",
    "members"
  ],
  "title": "MathOS Portable Release Manifest v2",
  "type": "object"
}
